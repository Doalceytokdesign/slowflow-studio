# Slow Flow Studio — n8n Local Environment Variables
# Copie este arquivo para .env se desejar customizar as variáveis:
# cp .env.example .env

N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
NODE_ENV=production
WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=America/Sao_Paulo
TZ=America/Sao_Paulo
